{
  "name": "@ainote/server",
  "version": "1.0.0",
  "main": "index.cjs",
  "type": "module",
  "scripts": {
    "start": "tsx index.js",
    "db:init": "node scripts/init-zhparser-v2.cjs",
    "dev": "npm run db:init && nodemon --exec tsx index.js",
    "worker": "node temporal/worker.js",
    "dev:worker": "nodemon temporal/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js,.mjs --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.mjs --max-warnings=0 --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "seed:members": "node scripts/seed-members.js",
    "trace": "cat ../logs/traces/$(ls -t ../logs/traces/ | head -n 1)",
    "trace:watch": "node scripts/trace-viewer.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit introspect"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
