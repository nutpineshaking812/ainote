  "scripts": {
    "start": "vite --port 5000",
    "dev": "npm run clean && vite --force --port 5000 --host 127.0.0.1",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules/.vite",
    "clean:tauri": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "clean:all": "rm -rf dist node_modules/.vite coverage && npm run clean:tauri",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "scan:i18n": "i18next-scanner --config i18next-scanner.config.js",
    "build:sdk": "vite build --config vite.sdk.config.js",
    "dev:sdk": "vite --config vite.sdk.dev.config.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:package": "node build_desktop.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
