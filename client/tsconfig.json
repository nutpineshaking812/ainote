{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "types": ["react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../1shared/src/*"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../1shared/src/blocknote/blocks/ChildDocumentBlock.js",
    "../1shared/src/blocknote/blocks/TitleBlock.js",
    "../1shared/src/blocknote/blocks/CodeBlock.js",
    "../1shared/src/blocknote/schema.js"
  ],
  "exclude": ["dist", "node_modules"]
}
