# ============================================================
# AINote Platform — Environment Variables
# ============================================================
# Copy to .env and edit:
#   cp .env.example .env
# ============================================================
#
# This file ONLY controls Docker infrastructure.
# App-level config (LLM keys, JWT, storage) goes to server/.env


# ──────────────────────────────────────────
# PostgreSQL (custom image with pgvector + AGE + zhparser)
# ──────────────────────────────────────────
POSTGRES_USER=ainote
POSTGRES_PASSWORD=ainote
POSTGRES_DB=ainote
PG_PORT=5432

# ──────────────────────────────────────────
# App Service Ports
# ──────────────────────────────────────────
BACKEND_PORT=5001
FRONTEND_PORT=8081
PYTHON_PORT=6010

# ──────────────────────────────────────────
# Infrastructure Ports
# ──────────────────────────────────────────
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
