# ============================================================
# AINote — Docker Compose 基础设施变量
#
# 仅包含 Docker 层面需要的变量（端口、数据库密码等）。
# 应用配置（LLM API Key、JWT 等）请见 server/.env.example
# ============================================================

# ── PostgreSQL ─────────────────────────────
POSTGRES_USER=ainote
POSTGRES_PASSWORD=ainote
POSTGRES_DB=ainote
PG_PORT=5432

# ── 应用端口 ──────────────────────────────
BACKEND_PORT=5001
FRONTEND_PORT=8081
PYTHON_PORT=6010
NODE_ENV=production

# ── Temporal ──────────────────────────────
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
